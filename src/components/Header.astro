---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="header-socials">
			<SocialLinks />
		</div>
		{/* Hidden until the script below runs: without JavaScript it couldn't do anything. */}
		<button type="button" class="theme-toggle" hidden>dark</button>
	</nav>
</header>

<script>
	// Rendered by this component on every page, so it's always there.
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
	const root = document.documentElement;

	function nextTheme() {
		return root.dataset.theme === 'dark' ? 'light' : 'dark';
	}

	// The label names the theme a click switches to, not the current one.
	function updateLabel() {
		button.textContent = nextTheme();
		button.setAttribute('aria-label', `Switch to ${nextTheme()} theme`);
	}

	button.addEventListener('click', () => {
		const theme = nextTheme();
		root.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {
			// Storage is blocked: the switch still works, it just won't be remembered.
		}
		updateLabel();
	});

	updateLabel();
	button.hidden = false;
</script>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--surface);
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		/* Lets the theme toggle drop to its own line rather than make a 375px screen
		   scroll sideways. */
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.theme-toggle {
		padding: 0.1em 0.6em;
		color: rgb(var(--black));
		font: inherit;
		background: none;
		border: 2px solid currentColor;
		cursor: pointer;
	}
	@media (max-width: 720px) {
		.header-socials {
			display: none;
		}
	}
</style>
