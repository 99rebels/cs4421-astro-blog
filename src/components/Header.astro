---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import SocialLinks from './SocialLinks.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="header-socials">
			<SocialLinks />
		</div>
		{/* Hidden until the script below runs: without JavaScript it couldn't do anything.
		    Both icons are always in the page; CSS shows the one for the theme a click
		    switches to, so the right icon is there before any script runs. */}
		<button type="button" class="theme-toggle" hidden>
			<svg class="moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<path fill="currentColor" d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
			</svg>
			<svg class="sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
				<circle cx="12" cy="12" r="4.5" fill="currentColor" />
				<path
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
				/>
			</svg>
		</button>
	</nav>
	<div class="stripes classic-only" aria-hidden="true"></div>
</header>

<script>
	// Rendered by this component on every page, so it's always there.
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;
	const root = document.documentElement;

	function nextTheme() {
		return root.dataset.theme === 'dark' ? 'light' : 'dark';
	}

	// The icons carry no text, so the label is what screen readers announce. It names the
	// theme a click switches to, not the current one.
	function updateLabel() {
		button.setAttribute('aria-label', `Switch to ${nextTheme()} theme`);
	}

	button.addEventListener('click', () => {
		const theme = nextTheme();
		root.dataset.theme = theme;
		try {
			localStorage.setItem('theme', theme);
		} catch {
			// Storage is blocked: the switch still works, it just won't be remembered.
		}
		updateLabel();
	});

	updateLabel();
	button.hidden = false;
</script>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 10;
		padding: 0 1em;
		background: var(--bar);
	}
	:global(:root[data-view='terminal']) header {
		border-bottom: 3px solid var(--border);
	}
	/* The stripes run the full width of the page, under the header. */
	.stripes {
		height: 10px;
		margin: 0 -1em;
	}
	nav {
		display: flex;
		/* Lets items drop to a second line rather than make a 375px screen scroll sideways. */
		flex-wrap: wrap;
		gap: 0 var(--space-sm);
		align-items: center;
		justify-content: space-between;
		max-width: var(--content-width-wide);
		margin: 0 auto;
		padding: 0.6em 0;
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
	}
	h2 a {
		color: var(--ink);
		text-decoration: none;
	}
	/* Classic: the site name as a serif wordmark, after a little striped sunset. */
	:global(:root:not([data-view='terminal'])) h2 a {
		display: inline-flex;
		gap: 0.4em;
		align-items: center;
		font-family: var(--font-heading);
		font-size: 1.2em;
		font-style: italic;
	}
	:global(:root:not([data-view='terminal'])) h2 a::before {
		content: '';
		width: 1.6em;
		height: 0.8em;
		background: var(--stripes);
		border: 2px solid var(--border);
		border-bottom: none;
		border-radius: 1.6em 1.6em 0 0;
	}
	/* Terminal: the site name is the prompt. */
	:global(:root[data-view='terminal']) h2 a::before {
		content: 'rian@ul:~$ ' / '';
		color: var(--accent);
	}
	.internal-links {
		display: flex;
		gap: 0.25em;
	}
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.2em;
		padding: 0.3em;
		color: var(--ink);
		font: inherit;
		background: var(--card);
		border: 2px solid var(--border);
		border-radius: 999px;
		cursor: pointer;
		transition: transform 0.3s;
	}
	:global(:root:not([data-view='terminal'])) .theme-toggle:hover {
		background: var(--accent-2);
	}
	/* Terminal: square brackets around the icon, like [☾]. */
	:global(:root[data-view='terminal']) .theme-toggle {
		padding: 0.1em 0.2em;
		border: none;
		border-radius: 0;
		background: none;
	}
	:global(:root[data-view='terminal']) .theme-toggle::before {
		content: '[';
	}
	:global(:root[data-view='terminal']) .theme-toggle::after {
		content: ']';
	}
	/* The moon in light mode (click for dark), the sun in dark mode. */
	:global(:root[data-theme='dark']) .moon,
	:global(:root:not([data-theme='dark'])) .sun {
		display: none;
	}
	@media (max-width: 720px) {
		.header-socials {
			display: none;
		}
	}
</style>
