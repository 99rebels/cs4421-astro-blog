---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { resolveTheme } from '../utils/theme';

interface Props {
	title: string;
	description: string;
	// A page's scoped styles cannot reach an element rendered by this layout, so pages
	// pick their column width here instead of styling <main> themselves.
	width?: 'default' | 'wide' | 'full';
}

const { title, description, width = 'default' } = Astro.props;

// The theme must be set before the page first paints, or a visitor who chose dark sees
// a flash of light first. Bundled scripts are deferred until after the page is parsed,
// so this has to be an inline script. Inline scripts can't import, so the tested
// resolveTheme is pasted in as source text. localStorage throws when the browser blocks
// storage, so a failed read counts as "nothing stored".
const themeScript = `
	let stored = null;
	try {
		stored = localStorage.getItem('theme');
	} catch {}
	const prefersDark = matchMedia('(prefers-color-scheme: dark)').matches;
	document.documentElement.dataset.theme = (${resolveTheme.toString()})(stored, prefersDark);
`;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<script is:inline set:html={themeScript} />
	</head>
	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<Header />
		{/* tabindex="-1" lets the skip link move focus here without adding <main> to the Tab order. */}
		<main
			id="main-content"
			tabindex="-1"
			class:list={{ wide: width === 'wide', full: width === 'full' }}
		>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	/* Off-screen rather than display: none, which would also remove it from the Tab order.
	   It appears when focused so sighted keyboard users can see what they're on. */
	.skip-link {
		position: absolute;
		top: -10em;
		left: var(--space-sm);
		padding: 0.5em 1em;
		background: var(--surface);
	}
	.skip-link:focus {
		top: var(--space-sm);
	}
	/* <main> only takes focus as the skip link's landing spot. It isn't a control, so a
	   ring around the whole content area would signal something that can't be activated. */
	main:focus {
		outline: none;
	}
	main.wide {
		width: var(--content-width-wide);
	}
	main.full {
		width: calc(100% - 2em);
		max-width: 100%;
		margin: 0;
	}
</style>
