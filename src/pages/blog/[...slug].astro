---
import { getEntry, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

// In server mode this page runs on each request, and getStaticPaths() is ignored, so the
// post has to be looked up from the URL rather than handed in as props at build time.
const { slug } = Astro.params;
const post = slug ? await getEntry('blog', slug) : undefined;

// Unknown posts and, in production, drafts both get a plain 404. Drafts get the same
// response so their URL can't be guessed; `astro dev` still shows them for previewing.
if (!post || (import.meta.env.PROD && post.data.draft)) {

	return new Response(null, { status: 404 });
}

const { Content } = await render(post);
const author = await getEntry('authors', post.data.author);

if (!author) {
	throw new Error(`Author not found: ${post.data.author}`);
}
---

<BlogPost {...post.data} author={author.data}>
	<Content />
</BlogPost>
