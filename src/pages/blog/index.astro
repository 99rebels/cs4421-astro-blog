---
import FormattedDate from '../../components/FormattedDate.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getSql } from '../../db/client';
import { listPosts } from '../../db/posts';
import { readingTime } from '../../utils/posts';

const posts = await listPosts(getSql());
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} width="wide">
	<section>
		{
			posts.length === 0 ? (
				<p class="no-posts">No posts yet — check back soon.</p>
			) : (
				<ul>
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.slug}/`}>
								<h4 class="title">{post.title}</h4>
								<p class="date">
									<FormattedDate date={post.publishedAt} /> · {readingTime(post.body)} min read
								</p>
								{post.tags.length > 0 && (
									<p class="tags">
										{post.tags.map((tag) => (
											<span class="tag">#{tag}</span>
										))}
									</p>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</BaseLayout>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 2rem;
		list-style-type: none;
		margin: 0;
		padding: 0;
	}
	ul li {
		width: calc(50% - 1rem);
	}
	ul li * {
		text-decoration: none;
		transition: 0.2s ease;
	}
	ul li:first-child {
		width: 100%;
		margin-bottom: 1rem;
		text-align: center;
	}
	ul li:first-child .title {
		font-size: 2.369rem;
	}
	ul li a {
		display: block;
	}
	.title {
		margin: 0;
		color: rgb(var(--black));
		line-height: 1;
	}
	.date {
		margin: 0;
		color: rgb(var(--gray));
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin: 0.25em 0 0;
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
	ul li:first-child .tags {
		justify-content: center;
	}
	ul li a:hover h4,
	ul li a:hover .date {
		color: rgb(var(--accent));
	}
	.no-posts {
		color: rgb(var(--gray));
		text-align: center;
	}
	@media (max-width: 720px) {
		ul {
			gap: 0.5em;
		}
		ul li {
			width: 100%;
			text-align: center;
		}
		ul li:first-child {
			margin-bottom: 0;
		}
		ul li:first-child .title {
			font-size: 1.563em;
		}
	}
</style>
