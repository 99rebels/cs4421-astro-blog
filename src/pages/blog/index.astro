---
import FormattedDate from '../../components/FormattedDate.astro';
import Window from '../../components/Window.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { getSql } from '../../db/client';
import { listPosts } from '../../db/posts';
import { readingTime } from '../../utils/posts';

const posts = await listPosts(getSql());
---

<BaseLayout title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} width="wide">
	<Window path="~/blog">
		<p class="command terminal-only" aria-hidden="true">ls -lt ~/blog</p>
		<h1>Blog</h1>
		<p class="intro">A daily brief on AI, tech, markets and space, plus the podcasts worth your time.</p>
		{
			posts.length === 0 ? (
				<p class="no-posts">No posts yet — check back soon.</p>
			) : (
				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.slug}/`}>
								<div class="stripes classic-only" aria-hidden="true" />
								<h2>{post.title}</h2>
								<p class="meta">
									<FormattedDate date={post.publishedAt} /> · {readingTime(post.body)} min read
								</p>
								<p class="description">{post.description}</p>
								{post.tags.length > 0 && (
									<ul class="tags" aria-label="Tags">
										{post.tags.map((tag) => (
											<li>{tag}</li>
										))}
									</ul>
								)}
							</a>
						</li>
					))}
				</ul>
			)
		}
	</Window>
</BaseLayout>

<style>
	.intro,
	.no-posts {
		color: var(--muted);
	}
	.posts {
		display: grid;
		gap: var(--space-lg);
		margin: var(--space-lg) 0 0;
		padding: 0;
		list-style: none;
	}
	.posts > li > a {
		display: block;
		color: var(--text);
		text-decoration: none;
	}
	.meta {
		margin: 0;
		color: var(--muted);
		font-size: 0.85em;
	}

	/* Classic: each post is a card with sunset stripes along the top, lifting on hover. */
	:global(:root:not([data-view='terminal'])) .posts > li > a {
		overflow: hidden;
		padding: 0 var(--space-lg) var(--space-md);
		background: var(--card);
		border: 3px solid var(--border);
		border-radius: var(--radius);
		box-shadow: var(--shadow);
		transition: transform 0.15s, box-shadow 0.15s;
	}
	.posts .stripes {
		height: 8px;
		margin: 0 calc(-1 * var(--space-lg)) var(--space-md);
	}
	:global(:root:not([data-view='terminal'])) .posts > li > a:hover {
		transform: translateY(-3px);
		box-shadow: 4px 7px 0 var(--shadow-colour);
	}
	:global(:root:not([data-view='terminal'])) .posts h2 {
		font-size: var(--font-step-2);
	}
	:global(:root:not([data-view='terminal'])) .posts > li > a:hover h2 {
		text-decoration: underline 3px var(--accent);
		text-underline-offset: 0.15em;
	}
	.description {
		margin: var(--space-xs) 0 var(--space-sm);
	}

	/* Terminal: an ls -l listing. The description stays, as the line under each entry. */
	:global(:root[data-view='terminal']) .posts {
		gap: var(--space-sm);
	}
	:global(:root[data-view='terminal']) .posts > li > a {
		padding: 0.2em 0.4em;
	}
	:global(:root[data-view='terminal']) .posts > li > a:hover {
		background: var(--ink);
	}
	:global(:root[data-view='terminal']) .posts > li > a:hover :is(h2, p, li) {
		color: var(--card);
	}
	:global(:root[data-view='terminal']) .posts h2::before {
		content: '-rw-r--r--  ' / '';
		color: var(--muted);
		font-weight: 400;
	}
	:global(:root[data-view='terminal']) .description {
		margin: 0;
		color: var(--muted);
	}
</style>
